# Maintainer: qiumix <qiumix@example.com>
#
# Prebuilt binary from the release workflow. The tarball unpacks into
# niri-tracker-<target>/ containing the binary and its JSON schema.

pkgname=niri-tracker-bin
_pkgname=niri-tracker
pkgver=0.1.0
pkgrel=1
pkgdesc="Screen time tracking for the niri Wayland compositor (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/qiumix/niri-tracker"
license=('MIT')
depends=('glibc')
makedepends=()
provides=("$_pkgname")
conflicts=("$_pkgname" "${_pkgname}-git")
source_x86_64=("$pkgname-$pkgver.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local _target
  case "$CARCH" in
    x86_64)  _target=x86_64-unknown-linux-gnu ;;
    aarch64) _target=aarch64-unknown-linux-gnu ;;
  esac

  local _dir="${_pkgname}-${_target}"

  install -Dm755 "$_dir/$_pkgname" -t "$pkgdir/usr/bin/"
  install -Dm644 "$_dir/schema.json" -t "$pkgdir/usr/share/niri-tracker/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"

  # Completions come from the shipped binary, so they match the prebuilt one
  # rather than whatever the packager happens to have installed.
  local shell
  for shell in bash zsh fish; do
    "$pkgdir/usr/bin/$_pkgname" completions "$shell" > "$srcdir/$shell.completion"
  done
  install -Dm644 "$srcdir/bash.completion" \
    "$pkgdir/usr/share/bash-completion/completions/$_pkgname"
  install -Dm644 "$srcdir/zsh.completion" \
    "$pkgdir/usr/share/zsh/site-functions/_$_pkgname"
  install -Dm644 "$srcdir/fish.completion" \
    "$pkgdir/usr/share/fish/vendor_completions.d/$_pkgname.fish"

  # The service file is identical to the one in the source tree; keep it in the
  # package instead of fetching a second copy at build time.
  install -Dm644 "$srcdir/niri-tracker.service" -t "$pkgdir/usr/lib/systemd/user/"
}
